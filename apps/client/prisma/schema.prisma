generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  CUSTOMER
  ADMIN
}

enum AdminPermission {
  MANAGE_ADMINS
  COUNTRIES_VIEW
  COUNTRIES_EDIT
  VOTES_VIEW
  VOTES_ADJUST
  USERS_VIEW
  USERS_MANAGE
  AUDIT_LOGS_VIEW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum VoteIntentionType {
  FREE // daily free votes
  PURCHASED // purchased votes
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SYSTEM // all users will receive this notification via sse
}

enum SponsorBillingStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model User {
  id                String                @id
  name              String
  email             String
  emailVerified     Boolean               @default(false)
  image             String?
  role              UserRole              @default(USER)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sessions          Session[]
  accounts          Account[]
  userPaymentLogs   UserPaymentLog[]
  payments          Payment[]
  voteLogs          VoteLog[]
  pushNotifications PushNotification[]
  countryVoteFrees  CountryVoteFree[]
  countryVotePaids  CountryVotePaid[]
  dailyVoteUsage    DailyVoteUsage[]
  permissions       UserAdminPermission[]
  auditLogs         AuditLog[]
  sponsors          Sponsor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Country {
  id                 String            @id @default(uuid())
  code               String            @unique
  slug               String            @unique
  flag               String            @default("")
  name               String
  totalUpvoteCount   BigInt            @default(0) // never negative
  totalDownvoteCount BigInt            @default(0) // never negative
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  countryFreeVotes   CountryVoteFree[]
  countryPaidVotes   CountryVotePaid[]
  voteLogs           VoteLog[]
  sponsors           Sponsor[]

  @@index([totalUpvoteCount(sort: Desc), id])
  @@map("country_code")
}

// This is a append only log
model CountryVoteFree {
  id        String   @id @default(uuid())
  count     Int      @default(0)
  voteType  VoteType
  countryId String
  userId    String // vote by userId
  voteLogId String?  @unique
  voteLog   VoteLog? @relation(fields: [voteLogId], references: [id], onDelete: Restrict)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([userId])
  @@map("country_free_vote")
}

// This is a append only log
model CountryVotePaid {
  id        String   @id @default(uuid())
  count     Int      @default(0)
  voteType  VoteType
  countryId String
  userId    String // vote by userId
  voteLogId String?  @unique
  voteLog   VoteLog? @relation(fields: [voteLogId], references: [id], onDelete: Restrict)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([userId])
  @@map("country_paid_vote")
}

// This is a append only log
// overall vote log for each country, regardless of free or paid votes
model VoteLog {
  id                String            @id @default(uuid())
  count             Int               @default(0)
  voteType          VoteType
  voteIntentionType VoteIntentionType
  countryId         String
  userId            String // vote by userId
  requestId         String?           @unique
  result            Json?
  freeDetail        CountryVoteFree?
  paidDetail        CountryVotePaid?

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([countryId])
  @@index([userId])
  @@map("vote_log")
}

model Sponsor {
  id          String  @id @default(uuid())
  userId      String?
  countryId   String?
  name        String
  description String?
  logo        String
  bgColor     String?
  textColor   String?
  website     String

  country Country? @relation(fields: [countryId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  slots                Slots[]
  sponsorBillingCycles SponsorBillingCycle[]

  @@map("sponsor")
}

// currently max 20 slots.
model Slots {
  id        String  @id @default(uuid())
  sponsorId String
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  isActive  Boolean @default(true)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sponsorBillingCycles SponsorBillingCycle[]

  @@map("slots")
}

model SponsorBillingCycle {
  id         String               @id @default(uuid())
  sponsorId  String
  slotId     String
  paymentsId String?              @unique @db.Uuid
  startDate  DateTime             @db.Timestamp(3)
  endDate    DateTime             @db.Timestamp(3)
  status     SponsorBillingStatus @default(ACTIVE)

  sponsor  Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Restrict)
  payments Payment? @relation(fields: [paymentsId], references: [id], onDelete: Restrict)
  slot     Slots    @relation(fields: [slotId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sponsorId])
  @@index([slotId])
  @@index([slotId, startDate, endDate])
  @@map("sponsor_billing_cycle")
}

model UserPaymentLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String // purchased by userId
  paymentId       String   @unique @db.Uuid
  purchasedAmount Decimal  @db.Decimal(10, 2)
  currency        String
  createdAt       DateTime @default(now()) @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String // associated with a user
  dodoPaymentId String?       @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  voteQuantity  Int? // Snapshotted by trusted checkout code; never inferred from amount.
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: NoAction)

  transaction         PaymentTransaction?
  userPaymentLog      UserPaymentLog?
  sponsorBillingCycle SponsorBillingCycle?

  @@index([userId])
}

model PaymentTransaction {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @unique @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentWebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz
}

model PushNotification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String?
  title            String
  message          String
  notificationType NotificationType
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model DailyVoteUsage {
  id                String   @id @default(uuid())
  userId            String
  voteDate          DateTime @db.Date
  usedCount         Int      @default(0)
  upvoteUsedCount   Int      @default(0)
  downvoteUsedCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, voteDate])
  @@map("daily_vote_usage")
}

model VoteRateLimit {
  key         String   @id
  windowStart DateTime
  attempts    Int

  @@map("vote_rate_limit")
}

model UserAdminPermission {
  id         String          @id @default(uuid())
  userId     String
  permission AdminPermission
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_admin_permission")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}
